<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav_stack</name>
  <version>1.0.0</version>
  <description>Shared navigation nodes for Zenith mission repos: stream rates and takeoff on GO (init), GPS to local conversion from the mavros home (convert), the only node that commands the drone in the Task 1 navigation (guidance)</description>
  <maintainer email="colinc131@gmail.com">Colin Rousseau</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>custom_interfaces</depend>
  <depend>tools</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>   <!-- local_planner ; clarabel (pas de clé rosdep) : pip dans le Dockerfile -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
