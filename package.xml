<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav_stack</name>
  <version>1.0.0</version>
  <description>Shared navigation nodes for Zenith mission repos: stream rates, takeoff point and takeoff on GO (init), GPS to local conversion service (convert)</description>
  <maintainer email="colinc131@gmail.com">Colin Rousseau</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>custom_interfaces</depend>
  <depend>tools</depend>
  <exec_depend>python3-geopy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
